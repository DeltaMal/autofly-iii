# Copy to ext/docker/.env.dev (git-ignored). Dev values only; never production secrets.
APP_ENV=local
APP_DEBUG=true
# 32 characters exactly, e.g.: head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32
APP_KEY=ChangeMeToA32CharacterStringNow!
APP_URL=http://localhost:8090
SITE_OWNER=dev@example.com
TZ=Africa/Johannesburg
DEFAULT_LANGUAGE=en_US
TRUSTED_PROXIES=**
LOG_CHANNEL=stack
APP_LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=dev-password-only

# MariaDB container
MARIADB_RANDOM_ROOT_PASSWORD=yes
MARIADB_USER=firefly
MARIADB_PASSWORD=dev-password-only

MAIL_MAILER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
STATIC_CRON_TOKEN=devdevdevdevdevdevdevdevdevdev12
